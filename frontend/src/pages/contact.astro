---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact Us - BodhicAI">
    <div style="max-width: 800px; margin: 0 auto; padding: var(--space-2xl) 0;">
        <h1 style="font-size: clamp(24px, 5vw, 36px); margin-bottom: var(--space-lg);">Contact Us</h1>
        <div style="color: var(--body); line-height: 1.8; font-size: 16px;">
            <p style="margin-bottom: var(--space-xl);">We're here to help. Whether you have a question about a skill you purchased, need help setting up your creator profile, or have inquiries regarding our platform, feel free to reach out.</p>
            
            <div class="card" style="padding: var(--space-xl); margin-bottom: var(--space-lg);">
                <h3 style="font-size: 18px; color: var(--ink); margin-bottom: var(--space-sm);">Customer Support</h3>
                <p style="margin: 0;">Email: <a href="mailto:support@bodhicai.tech?subject=Support%20Inquiry" style="color: var(--primary);">support@bodhicai.tech</a></p>
                <p style="margin-top: 8px; color: var(--mute); font-size: 14px;">Our support team typically responds within 24 hours.</p>
            </div>
            
            <div class="card" style="padding: var(--space-xl); margin-bottom: var(--space-lg);">
                <h3 style="font-size: 18px; color: var(--ink); margin-bottom: var(--space-sm);">Business Inquiries</h3>
                <p style="margin: 0;">Email: <a href="mailto:support@bodhicai.tech?subject=Business%20Inquiry" style="color: var(--primary);">support@bodhicai.tech</a></p>
            </div>
            
            <div class="card" style="padding: var(--space-xl);">
                <h3 style="font-size: 18px; color: var(--ink); margin-bottom: var(--space-sm);">Registered Address</h3>
                <p style="margin: 0;">BodhicAI Inc.<br />
                Bangalore, Karnataka<br />
                India</p>
            </div>

            <div class="card" style="padding: var(--space-xl); margin-top: var(--space-lg); border: 1px solid var(--hairline-strong);">
                <h3 style="font-size: 18px; color: var(--ink); margin-bottom: var(--space-sm);">Grievance Officer</h3>
                <p style="margin: 0; font-size: 14px; color: var(--mute); margin-bottom: var(--space-sm);">As per the Information Technology Act, 2000 and the Digital Personal Data Protection Act (DPDPA), 2023</p>
                <p style="margin: 0;"><strong style="color: var(--ink);">Name:</strong> Srikaran Golla</p>
                <p style="margin: 4px 0 0;"><strong style="color: var(--ink);">Email:</strong> <a href="mailto:grievance@bodhicai.tech" style="color: var(--primary);">support@bodhicai.tech</a></p>
                <p style="margin: 4px 0 0;"><strong style="color: var(--ink);">Response Time:</strong> Within 48 hours of receiving the complaint</p>
                <p style="margin-top: var(--space-sm); font-size: 14px; color: var(--mute);">If you have any grievances regarding the processing of your personal data, content disputes, or any other platform-related concerns, please reach out to the Grievance Officer above.</p>
            </div>
        </div>
    </div>
</Layout>
