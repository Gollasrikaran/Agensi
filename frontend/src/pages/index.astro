---
import Layout from '../layouts/Layout.astro';
import TrendingSkillsIsland from '../components/TrendingSkillsIsland';
import { ShieldCheck, IndianRupee, Zap, ChevronRight } from 'lucide-react';
import { AnimatedGridPattern } from '../components/ui/animated-grid-pattern';
import { TextShimmer } from '../components/ui/text-shimmer';
import { ShimmerButton } from '../components/ui/shimmer-button';
---

<Layout 
	title="BodhicAI — AI Agent Skill & Prompt Marketplace" 
	description="Welcome to BodhicAI. The verified marketplace where developers discover, test, request, and monetize AI agent skills and prompt templates for Cursor, Windsurf, and Claude."
>
	<main id="app-landing-purpose" class="relative">
		<!-- Dynamic Hero Section -->
		<section class="relative flex min-h-[85vh] flex-col items-center justify-center overflow-hidden pt-24 pb-12">
			<!-- Magic UI Animated Grid Background -->
			<AnimatedGridPattern
				client:load
				numSquares={30}
				maxOpacity={0.15}
				duration={3}
				repeatDelay={1}
				className="absolute inset-0 h-full w-full skew-y-12"
			/>
			
			<!-- Ambient Glow -->
			<div class="absolute -top-[20%] -left-[10%] h-[50vw] w-[50vw] rounded-full bg-indigo-500/20 blur-[120px] -z-10"></div>
			<div class="absolute -bottom-[20%] -right-[10%] h-[50vw] w-[50vw] rounded-full bg-violet-500/20 blur-[120px] -z-10"></div>

			<div class="relative z-10 mx-auto max-w-4xl px-4 text-center">
				<div class="mb-8 inline-flex items-center rounded-full border border-indigo-500/30 bg-indigo-500/10 px-3 py-1 text-xs font-medium uppercase tracking-widest text-indigo-300">
					The Premier Ecosystem
				</div>
				
				<h1 class="mb-6 text-5xl font-extrabold tracking-tighter sm:text-6xl md:text-7xl lg:text-8xl">
					<TextShimmer client:load duration={2} className="inline-block font-sans">
						BodhicAI
					</TextShimmer>
					<br />
					<span class="text-zinc-100">&nbsp;AI Agent Skill &amp; Prompt Marketplace</span>
				</h1>
				
				<p class="mx-auto mb-10 max-w-2xl text-lg text-zinc-400 sm:text-xl">
					Discover, buy, and sell prompt artifacts built for AI agents. Every skill is scanned for prompt injections and security threats before it goes live.
				</p>
				
				<div class="flex flex-wrap items-center justify-center gap-4">
					<a href="/browse">
						<ShimmerButton client:load className="shadow-2xl">
							<span class="whitespace-pre-wrap text-center text-sm font-medium leading-none tracking-tight text-white dark:from-white dark:to-slate-900/10 lg:text-lg">
								Explore Skills
							</span>
						</ShimmerButton>
					</a>
					<a href="/sell" class="inline-flex h-12 items-center justify-center rounded-full border border-zinc-700 bg-zinc-900 px-8 text-sm font-medium text-zinc-100 shadow-sm transition-colors hover:bg-zinc-800 hover:text-white focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50">
						Start Creating
					</a>
				</div>
			</div>
		</section>

		<!-- Social Proof Strip -->
		<div class="border-y border-white/5 bg-zinc-950/50 backdrop-blur-sm py-4">
			<div class="mx-auto flex max-w-5xl flex-wrap items-center justify-center gap-8 text-sm font-medium text-zinc-500">
				<span class="flex items-center gap-2"><ShieldCheck size={16} /> Every skill security-scanned</span>
				<span class="flex items-center gap-2">🇮🇳 Built in India</span>
				<span class="flex items-center gap-2"><Zap size={16} /> 200+ skills live</span>
			</div>
		</div>

		<!-- How It Works Flow -->
		<section class="py-24">
			<div class="mx-auto max-w-6xl px-4 text-center">
				<h2 class="mb-4 text-3xl font-bold tracking-tight text-zinc-50 sm:text-4xl">Built for trust and speed.</h2>
				<p class="mb-16 text-lg text-zinc-400">How BodhicAI protects buyers and rewards creators.</p>

				<div class="grid gap-8 md:grid-cols-3">
					<div class="card-glow rounded-2xl border border-white/10 bg-zinc-900/50 p-8 text-left backdrop-blur-sm transition-transform hover:-translate-y-1">
						<div class="mb-6 inline-flex rounded-xl bg-indigo-500/20 p-3 text-indigo-400">
							<ShieldCheck size={28} />
						</div>
						<h3 class="mb-3 text-xl font-semibold text-zinc-100">Tier 1 Security Scanning</h3>
						<p class="text-zinc-400 leading-relaxed">Every uploaded skill undergoes automated OWASP LLM vulnerability scanning. We block prompt injections and leaked secrets before they reach the marketplace.</p>
					</div>
					
					<div class="card-glow rounded-2xl border border-white/10 bg-zinc-900/50 p-8 text-left backdrop-blur-sm transition-transform hover:-translate-y-1">
						<div class="mb-6 inline-flex rounded-xl bg-indigo-500/20 p-3 text-indigo-400">
							<IndianRupee size={28} />
						</div>
						<h3 class="mb-3 text-xl font-semibold text-zinc-100">Zero Buyer Markup</h3>
						<p class="text-zinc-400 leading-relaxed">Buyers pay the exact base price set by the creator in INR. No hidden conversion fees, no subscription traps. Pure transactional value.</p>
					</div>
					
					<div class="card-glow rounded-2xl border border-white/10 bg-zinc-900/50 p-8 text-left backdrop-blur-sm transition-transform hover:-translate-y-1">
						<div class="mb-6 inline-flex rounded-xl bg-indigo-500/20 p-3 text-indigo-400">
							<Zap size={28} />
						</div>
						<h3 class="mb-3 text-xl font-semibold text-zinc-100">Instant Creator Payouts</h3>
						<p class="text-zinc-400 leading-relaxed">Creators take home an industry-leading 80% split. Request a payout anytime to your UPI or bank account directly from your creator wallet.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Live Marketplace Preview -->
		<section class="border-t border-white/5 py-24">
			<div class="mx-auto max-w-7xl px-4">
				<div class="mb-12 flex flex-wrap items-end justify-between gap-6">
					<div>
						<h2 class="mb-2 text-3xl font-bold tracking-tight text-zinc-50 sm:text-4xl">Trending Agent Skills</h2>
						<p class="text-zinc-400">The most popular verified skills this week.</p>
					</div>
					<a href="/browse" class="group inline-flex items-center gap-1 text-sm font-medium text-indigo-400 hover:text-indigo-300">
						View All <ChevronRight size={16} class="transition-transform group-hover:translate-x-1" />
					</a>
				</div>
				<TrendingSkillsIsland client:visible />
			</div>
		</section>

		<!-- Final CTA Band -->
		<section class="relative overflow-hidden border-t border-white/10 bg-zinc-950 py-24 text-center">
			<div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-indigo-500 to-transparent"></div>
			<div class="mx-auto max-w-3xl px-4 relative z-10">
				<h2 class="mb-6 text-4xl font-bold tracking-tight text-zinc-50 sm:text-5xl">Stop giving away your prompts.</h2>
				<p class="mb-10 text-xl text-zinc-400">
					Package your expertise into reusable agent skills. Set your price in INR and keep 80% of every sale.
				</p>
				<a href="/sell">
					<ShimmerButton client:load className="mx-auto">
						<span class="text-base font-semibold text-white">Start Creating Now</span>
					</ShimmerButton>
				</a>
			</div>
		</section>
	</main>
</Layout>
