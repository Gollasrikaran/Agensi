---
import Layout from '../layouts/Layout.astro';
import TrendingSkillsIsland from '../components/TrendingSkillsIsland';
import { ShieldCheck, IndianRupee, Zap } from 'lucide-react';
---

<Layout 
	title="BodhicAI" 
	description="Welcome to BodhicAI. The verified marketplace where developers discover, test, request, and monetize AI agent skills and prompt templates for Cursor, Windsurf, and Claude. Sign in with Google to manage skills, API keys, and creator wallets."
	jsonLd={JSON.stringify({
		"@context": "https://schema.org",
		"@graph": [
			{
				"@type": "Organization",
				"name": "BodhicAI",
				"url": "https://bodhicai.tech",
				"logo": "https://bodhicai.tech/logo.png",
				"description": "BodhicAI is an action-agent skill and prompt marketplace for AI coding assistants. Developers can discover, test, and monetize custom MCP sidecar tools and prompt artifacts.",
				"sameAs": []
			},
			{
				"@type": "WebSite",
				"name": "BodhicAI",
				"url": "https://bodhicai.tech",
				"description": "The verified marketplace where developers discover, test, request, and monetize AI agent skills and prompt templates for Cursor, Windsurf, and Claude.",
				"potentialAction": {
					"@type": "SearchAction",
					"target": "https://bodhicai.tech/search?q={search_term_string}",
					"query-input": "required name=search_term_string"
				}
			},
			{
				"@type": "WebApplication",
				"name": "BodhicAI",
				"url": "https://bodhicai.tech",
				"applicationCategory": "DeveloperApplication",
				"operatingSystem": "Web",
				"description": "BodhicAI uses Google OAuth to securely log in users and authenticate access. We use these permissions solely to verify your identity, manage your purchased skill library, generate developer API keys, and process creator wallet payouts. We do not share your data with third parties."
			}
		]
	})}
>
	<main id="app-landing-purpose">
	<!-- Dynamic Hero Section -->
	<section style="min-height: 85vh; display: flex; flex-direction: column; justify-content: center; position: relative; overflow: hidden; padding-top: var(--space-4xl);">
		<!-- Background mesh effect -->
		<div style="position: absolute; top: -20%; left: -10%; width: 50vw; height: 50vw; background: radial-gradient(circle, var(--primary) 0%, transparent 60%); filter: blur(120px); opacity: 0.15; z-index: -1;"></div>
		<div style="position: absolute; bottom: -20%; right: -10%; width: 50vw; height: 50vw; background: radial-gradient(circle, var(--accent) 0%, transparent 60%); filter: blur(120px); opacity: 0.15; z-index: -1;"></div>

		<div style="max-width: 900px; margin: 0 auto; text-align: center; padding: 0 var(--space-md);">
			<span class="eyebrow" style="font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600; color: var(--primary); text-transform: uppercase; letter-spacing: 2px; padding: 6px 16px; background: var(--primary-soft); border-radius: var(--radius-pill); border: 1px solid rgba(79, 70, 229, 0.15); display: inline-block; margin-bottom: var(--space-md);">the premier ecosystem</span>
			
			<h1 style="font-size: clamp(var(--text-4xl), 8vw, var(--text-5xl)); line-height: 1.1; margin-bottom: var(--space-md); letter-spacing: -3px;">
				Welcome to <span class="gradient-text">BodhicAI</span>
			</h1>
			
			<p style="color: var(--body); font-size: clamp(var(--text-lg), 2vw, var(--text-xl)); max-width: 700px; margin: 0 auto var(--space-lg) auto; line-height: 1.5;">
				Discover, buy, and sell prompt artifacts built for AI agents. Every skill is scanned for prompt injections and security threats before it goes live.
			</p>

			<div style="background: var(--canvas-soft-2); border: 1px solid rgba(168, 85, 247, 0.35); border-radius: var(--radius-lg); padding: 18px 20px; max-width: 760px; margin: 0 auto var(--space-xl) auto; text-align: left; box-shadow: 0 8px 24px rgba(0,0,0,0.15);">
				<h3 style="font-size: 16px; font-weight: 700; color: var(--ink); margin-bottom: 8px; display: flex; align-items: center; gap: 8px;">
					<span>🛡️</span> Application Purpose & Google OAuth Disclosure
				</h3>
				<p style="color: var(--body); font-size: 14.5px; line-height: 1.6; margin: 0;">
					<strong>BodhicAI uses Google OAuth to securely log in users and authenticate access.</strong> We use these permissions solely to verify your identity, manage your purchased skill library, generate developer API keys, and process creator wallet payouts. <strong>We do not share your data with third parties.</strong>
				</p>
			</div>
			
			<div style="display: flex; gap: var(--space-md); justify-content: center; flex-wrap: wrap; margin-bottom: var(--space-4xl);">
				<a href="/browse" class="btn btn-primary btn-lg" style="padding: 16px 32px; font-size: var(--text-lg);">Explore Skills →</a>
				<a href="/sell" class="btn btn-secondary btn-lg" style="padding: 16px 32px; font-size: var(--text-lg); border-color: var(--hairline); background: var(--canvas-soft);">Start Selling</a>
			</div>
		</div>
	</section>

	<!-- Explicit Application Purpose & OAuth Overview Section (For Google Verification) -->
	<article style="padding: var(--space-4xl) 0; border-top: 1px solid var(--hairline); background: var(--canvas-soft);">
		<div style="max-width: 960px; margin: 0 auto; padding: 0 var(--space-md);">
			<section aria-label="Application Purpose and Google OAuth Disclosure" class="card" style="padding: var(--space-2xl); background: var(--canvas-soft-2); border: 1px solid rgba(168, 85, 247, 0.25); border-radius: 20px; box-shadow: 0 15px 35px rgba(0,0,0,0.25);">
				<div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(168, 85, 247, 0.15); color: #a855f7; padding: 6px 14px; border-radius: 20px; font-size: 12px; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase; margin-bottom: 12px;">
					ABOUT BODHICAI & APPLICATION PURPOSE
				</div>
				<h2 style="font-size: 26px; font-weight: 700; margin-bottom: var(--space-md); color: var(--ink);">Application Purpose &amp; Google OAuth Disclosure</h2>
				<p style="color: var(--body); font-size: 16px; line-height: 1.7; margin-bottom: var(--space-lg);">
					The core functional purpose of the <strong>BodhicAI</strong> web application is to serve as an online marketplace and developer ecosystem for prompt artifacts and artificial intelligence agent skills.
				</p>
				<p style="color: var(--body); font-size: 16px; line-height: 1.7; margin-bottom: var(--space-lg);">
					<strong>BodhicAI</strong> requests access to your Google identity information strictly via safe Google OAuth Single Sign-On procedures. We request permission to view your primary profile information solely to authenticate user system access, maintain individual user purchase libraries, generate secure developer API access keys, and process creator wallet monetization balance payouts.
				</p>
				<div class="responsive-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-lg); border-top: 1px solid var(--hairline); padding-top: var(--space-lg);">
					<div>
						<h3 style="font-size: 16px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">🔐 Why users sign in with Google</h3>
						<p style="color: var(--mute); font-size: 14px; line-height: 1.6; margin: 0;">
							We use Google OAuth (Single Sign-On) exclusively to authenticate user identity, generate secure developer API keys, maintain buyer purchase libraries, and manage seller wallet balances for skill monetization.
						</p>
					</div>
					<div>
						<h3 style="font-size: 16px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">🛡️ Data protection & privacy</h3>
						<p style="color: var(--mute); font-size: 14px; line-height: 1.6; margin: 0;">
							BodhicAI only requests basic profile information (email address, name, and profile avatar). We never access private Google Drive files, emails, or personal contacts, and we never sell user profile data to third parties.
						</p>
					</div>
				</div>
			</section>
		</div>
	</article>

	<!-- How It Works Flow -->
	<section style="padding: var(--space-5xl) 0; border-top: 1px solid var(--hairline);">
		<div style="text-align: center; margin-bottom: var(--space-4xl);">
			<h2 style="font-size: clamp(24px, 5vw, var(--text-4xl)); letter-spacing: -1.5px; margin-bottom: var(--space-xs);">Built for trust and speed.</h2>
			<p style="color: var(--mute); font-size: var(--text-lg);">How BodhicAI protects buyers and rewards creators.</p>
		</div>

		<div class="grid responsive-grid" style="grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--space-xl);">
			<div class="card" style="padding: var(--space-2xl); text-align: left; background: var(--canvas-soft-2); border: 1px solid var(--hairline-strong);">
				<div style="margin-bottom: var(--space-md);"><ShieldCheck style={{ width: '32px', height: '32px', color: 'var(--primary)' }} /></div>
				<h3 style="font-size: var(--text-xl); margin-bottom: var(--space-sm);">Tier 1 Security Scanning</h3>
				<p style="color: var(--body); font-size: var(--text-base); line-height: 1.6;">Every uploaded skill undergoes automated OWASP LLM vulnerability scanning. We block prompt injections and leaked secrets before they ever reach the marketplace.</p>
			</div>
			
			<div class="card" style="padding: var(--space-2xl); text-align: left; background: var(--canvas-soft-2); border: 1px solid var(--hairline-strong);">
				<div style="margin-bottom: var(--space-md);"><IndianRupee style={{ width: '32px', height: '32px', color: 'var(--primary)' }} /></div>
				<h3 style="font-size: var(--text-xl); margin-bottom: var(--space-sm);">Zero Buyer Markup</h3>
				<p style="color: var(--body); font-size: var(--text-base); line-height: 1.6;">Buyers pay the exact base price set by the creator in INR. No hidden conversion fees, no subscription traps. Pure transactional value.</p>
			</div>
			
			<div class="card" style="padding: var(--space-2xl); text-align: left; background: var(--canvas-soft-2); border: 1px solid var(--hairline-strong);">
				<div style="margin-bottom: var(--space-md);"><Zap style={{ width: '32px', height: '32px', color: 'var(--primary)' }} /></div>
				<h3 style="font-size: var(--text-xl); margin-bottom: var(--space-sm);">Instant Creator Payouts</h3>
				<p style="color: var(--body); font-size: var(--text-base); line-height: 1.6;">Creators take home an industry-leading 80% split. Request a payout anytime to your UPI or bank account directly from your seller wallet.</p>
			</div>
		</div>
	</section>

	<!-- Live Marketplace Preview -->
	<section style="padding: var(--space-5xl) 0; border-top: 1px solid var(--hairline);">
		<div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: var(--space-2xl); flex-wrap: wrap; gap: var(--space-md);">
			<div style="flex: 1; min-width: 250px;">
				<h2 style="font-size: clamp(24px, 6vw, var(--text-4xl)); letter-spacing: -1px; margin-bottom: var(--space-xs);">Trending Agent Skills</h2>
				<p style="color: var(--mute);">The most popular verified skills this week.</p>
			</div>
			<a href="/browse" class="btn btn-secondary" style="font-weight: 600;">View All →</a>
		</div>

		<TrendingSkillsIsland client:visible />
	</section>

	<!-- Final CTA Band -->
	<section class="band-soft" style="position: relative; text-align: center; color: var(--ink); overflow: hidden; border: 1px solid var(--hairline-strong);">
		<div style="position: absolute; top: 0; left: 0; width: 100%; height: 4px; background: linear-gradient(90deg, var(--primary), var(--accent));"></div>
		<h2 style="font-size: clamp(24px, 6vw, var(--text-5xl)); letter-spacing: -2px; margin-bottom: var(--space-md); color: var(--ink);">Stop giving away your prompts.</h2>
		<p style="font-size: var(--text-xl); color: var(--body); max-width: 600px; margin: 0 auto var(--space-xl) auto; opacity: 0.9;">
			Package your expertise into reusable agent skills. Set your price in INR and keep 80% of every sale.
		</p>
		<a href="/sell" class="btn btn-primary btn-lg" style="font-weight: 700; padding: 16px 40px; font-size: var(--text-lg);">Start Selling Now</a>
	</section>
	</main>
</Layout>
