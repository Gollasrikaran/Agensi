---
import Layout from '../../layouts/Layout.astro';
import NavbarIsland from '../../components/NavbarIsland';
import ProfileStatsHero from '../../components/ProfileStatsHero';
import SkillCard from '../../components/SkillCard';
import AchievementShowcase from '../../components/AchievementShowcase';
import NeuralStreakGraph from '../../components/NeuralStreakGraph';
import { API_BASE } from '../../lib/config';

const { username } = Astro.params;

let profile = null;
let error = null;

try {
  const res = await fetch(`${API_BASE}/api/public/profile/${username}`);
  if (!res.ok) {
    if (res.status === 404) {
      error = "User not found";
    } else if (res.status === 403) {
      error = "This profile is private";
    } else {
      error = "Failed to load profile";
    }
  } else {
    profile = await res.json();
  }
} catch (err) {
  error = "Failed to load profile";
}
---

<Layout 
  title={profile ? `${profile.username}'s AI Skills | BodhicAI` : "Profile Not Found | BodhicAI"}
  description={profile ? `Check out AI agent skills created by ${profile.username} on BodhicAI.` : "User profile on BodhicAI."}
>
  
  <main class="max-w-[1200px] mx-auto px-6 pt-16 pb-32 min-h-[80vh]">
    {error ? (
      <div class="text-center mt-[10vh]">
        <h1 class="text-[clamp(28px,6vw,48px)] mb-6 text-zinc-100 font-bold">{error}</h1>
        <a href="/" class="inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-6 py-2.5 text-sm font-bold text-white shadow-lg transition-all hover:bg-indigo-500 hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2 focus-visible:ring-offset-zinc-950 disabled:opacity-50 no-underline">Return Home</a>
      </div>
    ) : (
      <div class="flex flex-col gap-12">
        
        <!-- Stats Hero -->
        <ProfileStatsHero 
          profile={{
            username: profile.seller?.username || username,
            avatar_url: profile.seller?.avatar_url || '',
            avatar_tier: profile.seller?.avatar_tier || 'free',
            streak: profile.seller?.streak || 0,
            pulse_score: profile.seller?.pulse_score || 0,
            total_skills: profile.skills?.length || 0,
            total_sales: profile.seller?.total_sales || 0,
            is_verified: profile.seller?.is_verified || false,
            is_private: profile.seller?.is_private || false,
            join_date: new Date(profile.seller?.created_at || Date.now()).toLocaleDateString()
          }}
          client:load 
        />
        
        {/* Achievement Showcase */}
        {profile.seller?.is_private ? (
          <div class="text-center p-10 bg-zinc-900/50 rounded-2xl border border-dashed border-zinc-700 text-zinc-400">
            🔒 @{profile.seller?.username || username} has chosen to keep their achievements private.
          </div>
        ) : (
          <AchievementShowcase achievements={profile.achievements || []} client:load />
        )}

        <!-- Uploaded Skills Grid (GitHub Style) -->
        <div class="mt-6">
          <h2 class="text-2xl text-zinc-100 mb-8 flex items-center gap-3 border-b border-zinc-800 pb-4 font-bold">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-400"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path></svg>
            Uploaded Skills
            <span class="bg-zinc-800 text-zinc-300 px-2.5 py-0.5 rounded-full text-sm font-semibold">{profile.skills?.length || 0}</span>
          </h2>
          {profile.skills && profile.skills.length > 0 ? (
            <div class="grid grid-cols-[repeat(auto-fill,minmax(320px,1fr))] gap-8">
              {profile.skills.map((skill: any) => (
                <SkillCard skill={{...skill, seller: profile.seller}} client:load />
              ))}
            </div>
          ) : (
            <div class="text-center p-10 bg-zinc-900/50 rounded-2xl border border-dashed border-zinc-700 text-zinc-400">
              @{profile.seller?.username || username} hasn't uploaded any skills yet.
            </div>
          )}
        </div>
      </div>
    )}
  </main>
</Layout>
