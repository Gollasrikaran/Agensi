---
import Layout from '../../layouts/Layout.astro';
import PayoutsIsland from '../../components/PayoutsIsland.tsx';
---

<Layout 
	title="Admin Ledger — BodhicAI"
	description="Review and process creator payout requests."
>
    <div class="max-w-5xl mx-auto pt-16 pb-12 px-6 sm:px-8 lg:px-10">
		<div class="text-center mb-12">
			<span class="inline-flex items-center gap-2 rounded-full bg-indigo-500/10 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-indigo-400 border border-indigo-500/20 mb-6">
				<svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
				ledger
			</span>
			<h1 class="text-3xl sm:text-4xl font-black text-zinc-100 tracking-tight">Admin Ledger</h1>
			<p class="text-zinc-400 mt-3 max-w-xl mx-auto leading-relaxed">Review and process creator payout requests.</p>
		</div>
		<div class="mb-8">
			<a href="/admin" class="inline-flex items-center justify-center gap-2 rounded-xl border border-zinc-700 bg-zinc-900/80 px-5 py-2.5 text-sm font-bold text-zinc-300 transition-all hover:bg-zinc-800 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500">← Back to Admin</a>
		</div>

        <PayoutsIsland client:load />
	</div>
</Layout>
