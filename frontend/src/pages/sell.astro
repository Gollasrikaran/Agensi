---
import Layout from '../layouts/Layout.astro';
import UploadSkillFormIsland from '../components/UploadSkillFormIsland.tsx';
---

<Layout 
	title="Create AI Agent Skills — BodhicAI"
	description="Monetize your expertise. Upload your AI agent skills and prompts to BodhicAI. Get automated security verification and keep 80% of your sales."
>
	<div class="max-w-5xl mx-auto pt-16 pb-12 px-6 sm:px-8 lg:px-10">
		<div class="text-center mb-12">
			<span class="inline-flex items-center gap-2 rounded-full bg-indigo-500/10 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-indigo-400 border border-indigo-500/20 mb-6">
				<svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
				upload
			</span>
			<h1 class="text-3xl sm:text-4xl font-black text-zinc-100 tracking-tight">Publish your AI skill.</h1>
			<p class="text-zinc-400 mt-3 max-w-xl mx-auto leading-relaxed">Upload a .md file and our scanner will verify it for security before listing.</p>
		</div>
		<UploadSkillFormIsland client:load />
	</div>
</Layout>
