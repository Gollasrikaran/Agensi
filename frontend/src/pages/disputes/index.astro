---
import Layout from '../../layouts/Layout.astro';
---
<Layout 
	title="Disputes — BodhicAI"
	description="File a dispute for purchased AI agent skills. We review all disputes to ensure marketplace trust and safety."
>
	<div class="max-w-5xl mx-auto pt-16 pb-12 px-6 sm:px-8 lg:px-10">
		<div class="text-center mb-12">
			<span class="inline-flex items-center gap-2 rounded-full bg-indigo-500/10 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-indigo-400 border border-indigo-500/20 mb-6">
				<svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
				support
			</span>
			<h1 class="text-3xl sm:text-4xl font-black text-zinc-100 tracking-tight">File a Dispute</h1>
			<p class="text-zinc-400 mt-3 max-w-xl mx-auto leading-relaxed">If a skill you purchased doesn't work as advertised, let us know. We review all disputes and offer refunds where appropriate.</p>
		</div>
		<div class="card" style="padding: var(--space-xl);">
			<div class="form-group">
				<label>Purchase ID</label>
				<input type="text" placeholder="pur-12345" />
			</div>
			
			<div class="form-group">
				<label>Reason for Dispute</label>
				<textarea rows="4" placeholder="Please describe the issue in detail..."></textarea>
			</div>
			
			<button class="btn btn-primary" style="width: 100%; margin-top: var(--space-sm);">Submit Dispute →</button>
		</div>
	</div>
</Layout>
