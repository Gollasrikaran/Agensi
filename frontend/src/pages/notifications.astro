---
import Layout from '../layouts/Layout.astro';
import NavbarIsland from '../components/NavbarIsland';
import NotificationsIsland from '../components/NotificationsIsland';

const title = "Notifications | BodhicAI";
const description = "View and manage your notifications.";
---

<Layout title={title} description={description}>
  <NavbarIsland client:load />
  
  <main class="min-h-screen bg-zinc-950 pt-20">
    <div class="max-w-[800px] mx-auto px-6 pb-24">
      <NotificationsIsland client:only="react" />
    </div>
  </main>
</Layout>
