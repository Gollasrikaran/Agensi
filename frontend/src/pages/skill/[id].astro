---
import Layout from '../../layouts/Layout.astro';
import CheckoutIsland from '../../components/CheckoutIsland.tsx';
import ReviewsIsland from '../../components/ReviewsIsland.tsx';
import McpTestIsland from '../../components/McpTestIsland.tsx';
import EditSkillButtonIsland from '../../components/EditSkillButtonIsland.tsx';
import SkillShareBannerIsland from '../../components/SkillShareBannerIsland.tsx';
import TestBeforeBuyIsland from '../../components/TestBeforeBuyIsland.tsx';
import FileExplorerIsland from '../../components/FileExplorerIsland.tsx';
import InstallationCardIsland from '../../components/InstallationCardIsland.tsx';
import { Lock, ShieldAlert, Info, Star, ChevronLeft, Bot, ShieldCheck, Code2, GitFork, FolderArchive } from 'lucide-react';

const { id } = Astro.params;

let skill: any = null;
try {
	const res = await fetch(`${import.meta.env.PUBLIC_API_URL || 'http://localhost:8000'}/api/skills/${id}`);
	if (res.ok) skill = await res.json();
} catch (e) {
	console.error(e);
}

const isPaywalled = skill && (skill.base_price_inr || 0) > 0 && !skill.archive_url && !skill.source_url;

const jsonLd = skill ? JSON.stringify({
	"@context": "https://schema.org",
	"@type": "Product",
	"name": skill.title,
	"description": skill.description,
	"image": skill.cover_image_url || "https://bodhicai.tech/og-image.png",
	"offers": {
		"@type": "Offer",
		"price": skill.base_price_inr || 0,
		"priceCurrency": "INR",
		"availability": "https://schema.org/InStock"
	},
	"aggregateRating": skill.review_count > 0 ? {
		"@type": "AggregateRating",
		"ratingValue": skill.average_rating || 5,
		"reviewCount": skill.review_count
	} : undefined
}) : undefined;
---

<Layout 
	title={skill ? `${skill.title} — BodhicAI` : "Skill Not Found"}
	description={skill ? skill.description : "This AI agent skill could not be found."}
	image={skill?.cover_image_url}
	type="product"
	jsonLd={jsonLd}
>
	{!skill ? (
		<div class="flex flex-col items-center justify-center py-32 px-4 text-center">
			<h2 class="text-2xl font-bold text-zinc-100 mb-6">Skill not found.</h2>
			<a href="/browse" class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-6 py-3 text-sm font-semibold text-white shadow-lg transition-all hover:bg-indigo-500">
				<ChevronLeft class="h-4 w-4" /> Back to Browse
			</a>
		</div>
	) : (
		<div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
			<EditSkillButtonIsland client:load skill={skill} />
			
			<div class="mb-10">
				<div class="flex flex-wrap items-center gap-2 mb-4">
					{((skill.category || 'AI').split(',').map((c: string) => c.trim()).filter(Boolean)).map((cat: string) => (
						<a href={`/category/${encodeURIComponent(cat.toLowerCase().replace(/\s+/g, '-'))}`} class="inline-flex items-center rounded-full bg-zinc-800/80 px-2.5 py-0.5 text-xs font-semibold tracking-wider text-zinc-300 uppercase border border-zinc-700 hover:bg-zinc-700 transition-colors">
							{cat}
						</a>
					))}
					<span class="inline-flex items-center gap-1.5 rounded-full bg-purple-500/10 px-3 py-1 text-xs font-bold text-purple-400 border border-purple-500/20">
						Level {skill.complexity_level || 1}
					</span>
					<span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-3 py-1 text-xs font-bold text-emerald-400 border border-emerald-500/20">
						{({1:10, 2:20, 3:40, 4:70, 5:100} as Record<number, number>)[skill.complexity_level || 1] || ((skill.complexity_level || 1) * 10)} CR / chat
					</span>
					{skill.moderation_status === 'approved' ? (
						<span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-3 py-1 text-xs font-bold text-emerald-400 border border-emerald-500/20 shadow-[0_0_12px_rgba(16,185,129,0.15)]">
							<ShieldCheck class="h-3.5 w-3.5" /> OWASP Verified
						</span>
					) : (
						<span class="inline-flex items-center gap-1.5 rounded-full bg-amber-500/10 px-3 py-1 text-xs font-bold text-amber-400 border border-amber-500/20">
							⏳ Pending Review
						</span>
					)}
					<span class="inline-flex items-center gap-1.5 rounded-full bg-indigo-500/10 px-3 py-1 text-xs font-bold text-indigo-400 border border-indigo-500/20 shadow-[0_0_12px_rgba(99,102,241,0.15)]">
						<Bot class="h-3.5 w-3.5" /> MCP Ready
					</span>
				</div>
				
				<h1 class="text-3xl md:text-5xl lg:text-6xl font-bold tracking-tight text-zinc-100 mb-2 leading-tight">
					{skill.title}
				</h1>
				
				{skill.media_url && (
					<div class="mt-8 overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900/50 shadow-2xl backdrop-blur-sm">
						{skill.media_url.match(/\.(mp4|webm|ogg)$/i) ? (
							<video src={skill.media_url} controls playsinline class="w-full max-h-[600px] object-contain block bg-black/50"></video>
						) : (
							<img src={skill.media_url} alt={skill.title} referrerpolicy="no-referrer" class="w-full max-h-[600px] object-contain block bg-black/50" />
						)}
					</div>
				)}
			</div>

			<div class="rounded-2xl border border-zinc-800 bg-zinc-900/50 p-6 sm:p-8 mb-8 backdrop-blur-sm">
				<h3 class="mb-4 text-sm font-bold uppercase tracking-widest text-zinc-500">Description</h3>
				<p class="text-base leading-relaxed text-zinc-300 whitespace-pre-wrap">{skill.description}</p>
			</div>

			{skill.item_type === 'agent-tool' && (
				<>
					{/* Agent Tool Stats Bar */}
					<div class="flex flex-wrap gap-4 mb-8">
						<div class="flex items-center gap-2 rounded-xl border border-zinc-800 bg-zinc-900/50 px-4 py-3 text-zinc-300">
							<FolderArchive class="h-5 w-5 text-indigo-400" />
							<span class="font-medium">{skill.total_files || 0} Files</span>
						</div>
						{(skill.stars_count > 0 || skill.forks_count > 0) && (
							<>
								<div class="flex items-center gap-2 rounded-xl border border-zinc-800 bg-zinc-900/50 px-4 py-3 text-zinc-300">
									<Code2 class="h-5 w-5 text-zinc-400" />
									<span class="font-medium">{skill.stars_count} Stars</span>
								</div>
								<div class="flex items-center gap-2 rounded-xl border border-zinc-800 bg-zinc-900/50 px-4 py-3 text-zinc-300">
									<GitFork class="h-5 w-5 text-zinc-400" />
									<span class="font-medium">{skill.forks_count} Forks</span>
								</div>
							</>
						)}
					</div>

					{/* File Explorer & Install */}
					{skill.file_manifest && skill.file_manifest.length > 0 && (
						<div class="mb-8 relative">
							{isPaywalled && (
								<div class="absolute inset-0 z-10 flex flex-col items-center justify-center bg-zinc-950/80 backdrop-blur-md rounded-2xl border border-zinc-800">
									<Lock class="h-10 w-10 text-zinc-500 mb-3" />
									<h4 class="text-lg font-bold text-zinc-100 mb-1">Source Code Locked</h4>
									<p class="text-sm text-zinc-400 max-w-sm text-center mb-4">Purchase this agent tool to unlock the full source code and download the ZIP archive.</p>
								</div>
							)}
							<div class={isPaywalled ? "opacity-30 pointer-events-none select-none blur-sm transition-all" : ""}>
								<FileExplorerIsland 
									client:load 
									skillId={skill.id} 
									manifest={skill.file_manifest} 
									archiveUrl={skill.archive_url} 
								/>
							</div>
						</div>
					)}
					
					{(skill.install_command || skill.source_url) && (
						<div class="mb-8 relative">
							{isPaywalled && (
								<div class="absolute inset-0 z-10 flex flex-col items-center justify-center bg-zinc-950/80 backdrop-blur-md rounded-2xl border border-zinc-800">
									<Lock class="h-10 w-10 text-zinc-500 mb-3" />
									<h4 class="text-lg font-bold text-zinc-100 mb-1">Installation Locked</h4>
									<p class="text-sm text-zinc-400 max-w-sm text-center mb-4">Purchase this agent tool to unlock the private repository and installation commands.</p>
								</div>
							)}
							<div class={isPaywalled ? "opacity-30 pointer-events-none select-none blur-sm transition-all" : ""}>
								<InstallationCardIsland 
									client:load 
									installCommand={skill.install_command} 
									sourceUrl={skill.source_url} 
								/>
							</div>
						</div>
					)}
				</>
			)}

			<div class="rounded-2xl border border-zinc-800 bg-zinc-900/50 p-6 sm:p-8 mb-8 backdrop-blur-sm">
				<h3 class="mb-6 text-sm font-bold uppercase tracking-widest text-zinc-500">Domains & Compatibility</h3>
				<div class="mb-6">
					<div class="mb-3 text-sm font-semibold text-zinc-200">Domains</div>
					<div class="flex flex-wrap gap-2">
						{((skill.category || 'AI').split(',').map((c: string) => c.trim()).filter(Boolean)).map((cat: string) => (
							<a href={`/category/${encodeURIComponent(cat.toLowerCase().replace(/\s+/g, '-'))}`} class="inline-flex items-center gap-1.5 rounded-full bg-indigo-500/10 px-3.5 py-1.5 text-xs font-bold uppercase tracking-wider text-indigo-400 border border-indigo-500/20 hover:bg-indigo-500/20 transition-colors">
								{cat}
							</a>
						))}
					</div>
				</div>
				<div>
					<div class="mb-3 text-sm font-semibold text-zinc-200">Supported Functionality & Agents</div>
					<div class="flex flex-wrap gap-2">
						{['Cursor', 'Claude', 'Windsurf', 'MCP'].map(agent => (
							<span class="inline-flex items-center gap-1.5 rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-1.5 text-sm font-medium text-zinc-300">
								{agent}
							</span>
						))}
					</div>
				</div>
			</div>

			<div class="rounded-2xl border border-zinc-800 bg-zinc-900/50 p-6 sm:p-8 mb-8 backdrop-blur-sm">
				<h3 class="mb-4 text-sm font-bold uppercase tracking-widest text-zinc-500">Security Scan</h3>
				<div class="flex flex-col gap-3 text-sm text-zinc-300">
					<div class="flex items-center gap-2">
						<strong class="text-zinc-100">Status:</strong> 
						{skill.moderation_status === 'approved' ? (
							<span class="text-emerald-400 flex items-center gap-1"><ShieldCheck class="h-4 w-4" /> Passed</span>
						) : (
							<span class="text-amber-400 flex items-center gap-1"><ShieldAlert class="h-4 w-4" /> Flagged</span>
						)}
					</div>
					<div><strong class="text-zinc-100">Checks:</strong> <span class="font-mono text-xs text-zinc-400 ml-1 bg-zinc-800/50 px-2 py-0.5 rounded border border-zinc-700/50">OWASP LLM01, LLM06, LLM04</span></div>
					{skill.scan_summary_json?.issues && skill.scan_summary_json.issues.length > 0 && (
						<div class="mt-2 rounded-xl bg-red-500/10 border border-red-500/20 p-4 text-red-400">
							<strong class="block mb-2 text-red-300">Issues:</strong>
							<ul class="ml-5 list-disc space-y-1">
								{skill.scan_summary_json.issues.map((i: any) => (
									<li>{i.rule}: {i.description}</li>
								))}
							</ul>
						</div>
					)}
				</div>
			</div>

			<div class="rounded-2xl border border-zinc-800 bg-zinc-900/50 p-6 sm:p-8 mb-8 backdrop-blur-sm">
				<h3 class="mb-6 flex items-center gap-3 text-xl font-bold text-zinc-100">
					Buyer Reviews
					{skill.review_count > 0 && (
						<span class="inline-flex items-center gap-1 rounded-full bg-zinc-800 px-3 py-1 text-sm font-medium text-zinc-300 border border-zinc-700">
							<Star class="h-3.5 w-3.5 text-amber-400 fill-amber-400" /> {skill.average_rating ? Number(skill.average_rating).toFixed(1) : 0} ({skill.review_count})
						</span>
					)}
				</h3>
				<ReviewsIsland client:load skillId={skill.id} />
			</div>

			<div class="mb-8">
				<CheckoutIsland client:load skillId={skill.id} basePrice={skill.base_price_inr || skill.base_price_usd || 0} />
			</div>
			
			<div class="mb-8">
				<SkillShareBannerIsland client:load skillId={skill.id} skillTitle={skill.title} />
			</div>

			<TestBeforeBuyIsland client:load skillId={skill.id} sellerId={skill.seller_id} complexityLevel={skill.complexity_level || 1} />
		</div>
	)}
</Layout>
