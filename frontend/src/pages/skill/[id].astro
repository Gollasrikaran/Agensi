---
import Layout from '../../layouts/Layout.astro';
import CheckoutIsland from '../../components/CheckoutIsland.tsx';
import ReviewsIsland from '../../components/ReviewsIsland.tsx';
import McpTestIsland from '../../components/McpTestIsland.tsx';
import EditSkillButtonIsland from '../../components/EditSkillButtonIsland.tsx';
import SkillShareBannerIsland from '../../components/SkillShareBannerIsland.tsx';



const { id } = Astro.params;

let skill: any = null;
try {
	const res = await fetch(`${import.meta.env.PUBLIC_API_URL || 'http://localhost:8000'}/api/skills/${id}`);
	if (res.ok) skill = await res.json();
} catch (e) {
	console.error(e);
}

const jsonLd = skill ? JSON.stringify({
	"@context": "https://schema.org",
	"@type": "Product",
	"name": skill.title,
	"description": skill.description,
	"image": skill.cover_image_url || "https://bodhicai.tech/og-image.png",
	"offers": {
		"@type": "Offer",
		"price": skill.base_price_inr || 0,
		"priceCurrency": "INR",
		"availability": "https://schema.org/InStock"
	},
	"aggregateRating": skill.review_count > 0 ? {
		"@type": "AggregateRating",
		"ratingValue": skill.average_rating || 5,
		"reviewCount": skill.review_count
	} : undefined
}) : undefined;
---

<Layout 
	title={skill ? `${skill.title} — Bodhic AI` : "Skill Not Found"}
	description={skill ? skill.description : "This AI agent skill could not be found."}
	image={skill?.cover_image_url}
	type="product"
	jsonLd={jsonLd}
>
	{!skill ? (
		<div style="text-align: center; padding: var(--space-5xl);">
			<h2 style="font-size: 24px; margin-bottom: var(--space-md);">Skill not found.</h2>
			<a href="/browse" class="btn btn-primary">← Back to Browse</a>
		</div>
	) : (
		<div style="max-width: 800px; margin: 0 auto; padding-top: var(--space-xl);">
			<EditSkillButtonIsland client:load skill={skill} />
			<div style="margin-bottom: var(--space-xl);">
				<div style="display: flex; gap: var(--space-xs); margin-bottom: var(--space-sm); flex-wrap: wrap;">
					{((skill.category || 'AI').split(',').map((c: string) => c.trim()).filter(Boolean)).map((cat: string) => (
						<a href={`/category/${encodeURIComponent(cat.toLowerCase().replace(/\s+/g, '-'))}`} class="badge" style="text-transform: uppercase; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.5px; text-decoration: none;">🌐 {cat}</a>
					))}
					<span style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; background: var(--canvas-soft-2, #222); color: var(--accent, #a855f7); border: 1px solid var(--hairline-strong); border-radius: 12px; font-size: 12px; font-weight: 600;">
						⚡ Level {skill.complexity_level || 1}
					</span>
					<span style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; background: rgba(16, 185, 129, 0.1); color: var(--success); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 12px; font-size: 12px; font-weight: 600;">
						💎 {({1:10, 2:20, 3:40, 4:70, 5:100} as Record<number, number>)[skill.complexity_level || 1] || ((skill.complexity_level || 1) * 10)} CR / chat
					</span>
					{skill.moderation_status === 'approved' ? (
						<span style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; background: rgba(16, 185, 129, 0.1); color: var(--success); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 12px; font-size: 12px; font-weight: 600; box-shadow: 0 0 12px rgba(16, 185, 129, 0.2);">
							🛡️ Passed OWASP Security Scan
						</span>
					) : (
						<span class="badge warning">⏳ Pending Review</span>
					)}
					<span style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; background: var(--primary-soft); color: var(--primary); border: 1px solid var(--primary); border-radius: 12px; font-size: 12px; font-weight: 600; box-shadow: 0 0 12px var(--primary-soft);">
						🔌 MCP Ready
					</span>
				</div>
				<h1 style="font-size: 48px; margin-bottom: var(--space-xs);">{skill.title}</h1>
				
				{skill.media_url && (
					<div style="margin-top: var(--space-lg); border-radius: var(--radius-lg); overflow: hidden; background: var(--canvas-elevated); border: 1px solid var(--hairline); box-shadow: var(--shadow-sm);">
						{skill.media_url.match(/\.(mp4|webm|ogg)$/i) ? (
							<video src={skill.media_url} controls playsinline style="width: 100%; max-height: 500px; object-fit: contain; display: block;"></video>
						) : (
							<img src={skill.media_url} alt={skill.title} referrerpolicy="no-referrer" style="width: 100%; max-height: 500px; object-fit: contain; display: block;" />
						)}
					</div>
				)}
			</div>

			<div class="card" style="margin-bottom: var(--space-lg); padding: var(--space-xl);">
				<h3 style="font-size: 16px; color: var(--mute); font-weight: 600; margin-bottom: var(--space-sm);">Description</h3>
				<p style="color: var(--body); font-size: 16px; white-space: pre-wrap; line-height: 1.7;">{skill.description}</p>
			</div>

			<div class="card" style="margin-bottom: var(--space-lg); padding: var(--space-xl);">
				<h3 style="font-size: 16px; color: var(--mute); font-weight: 600; margin-bottom: var(--space-md);">Domains & Compatibility</h3>
				<div style="margin-bottom: var(--space-md);">
					<div style="font-size: 13px; font-weight: 600; color: var(--ink); margin-bottom: 8px;">Domains</div>
					<div style="display: flex; gap: 8px; flex-wrap: wrap;">
						{((skill.category || 'AI').split(',').map((c: string) => c.trim()).filter(Boolean)).map((cat: string) => (
							<a href={`/category/${encodeURIComponent(cat.toLowerCase().replace(/\s+/g, '-'))}`} style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; background: var(--primary-soft); color: var(--primary); border: 1px solid var(--primary); border-radius: var(--radius-pill); font-family: var(--font-mono); font-size: 12px; font-weight: 700; text-transform: uppercase; text-decoration: none;">
								🌐 {cat}
							</a>
						))}
					</div>
				</div>
				<div>
					<div style="font-size: 13px; font-weight: 600; color: var(--ink); margin-bottom: 8px;">Supported Functionality & Agents</div>
					<div style="display: flex; gap: 8px; flex-wrap: wrap;">
						{['Cursor', 'Claude', 'Windsurf', 'MCP'].map(agent => (
							<span style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; background: var(--canvas-soft); border: 1px solid var(--hairline); border-radius: 6px; font-size: 13px; color: var(--body); font-weight: 500;">
								💻 {agent}
							</span>
						))}
					</div>
				</div>
			</div>

			<div class="card" style="margin-bottom: var(--space-lg); padding: var(--space-xl);">
				<h3 style="font-size: 16px; color: var(--mute); font-weight: 600; margin-bottom: var(--space-sm);">Security Scan</h3>
				<div style="display: flex; flex-direction: column; gap: var(--space-xs); font-size: 14px; color: var(--body);">
					<div><strong style="color: var(--ink);">Status:</strong> {skill.moderation_status === 'approved' ? '✓ Passed' : '⚠ Flagged'}</div>
					<div><strong style="color: var(--ink);">Checks:</strong> <span style="font-family: var(--font-mono); font-size: 12px;">OWASP LLM01, LLM06, LLM04</span></div>
					{skill.scan_summary_json?.issues && skill.scan_summary_json.issues.length > 0 && (
						<div style="color: var(--error); margin-top: var(--space-sm);">
							<strong>Issues:</strong>
							<ul style="margin-left: var(--space-lg); margin-top: var(--space-xxs);">
								{skill.scan_summary_json.issues.map((i: any) => (
									<li style="margin-bottom: 2px;">{i.rule}: {i.description}</li>
								))}
							</ul>
						</div>
					)}
				</div>
			</div>

			<div class="card" style="margin-bottom: var(--space-lg); padding: var(--space-xl);">
				<h3 style="font-size: 20px; color: var(--ink); font-weight: 700; margin-bottom: var(--space-md); display: flex; align-items: center; gap: 8px;">
					Buyer Reviews
					{skill.review_count > 0 && (
						<span style="font-size: 14px; font-weight: 500; color: var(--mute); background: var(--canvas-soft); padding: 2px 8px; border-radius: 12px;">
							★ {skill.average_rating ? Number(skill.average_rating).toFixed(1) : 0} ({skill.review_count})
						</span>
					)}
				</h3>
				<ReviewsIsland client:load skillId={skill.id} />
			</div>

			<CheckoutIsland client:load skillId={skill.id} basePrice={skill.base_price_inr || skill.base_price_usd || 0} />
			
			<div style="margin-top: var(--space-xl);">
				<SkillShareBannerIsland client:load skillId={skill.id} skillTitle={skill.title} />
			</div>

			<div style="margin-top: var(--space-xl); padding: var(--space-xl); background: var(--canvas-soft); border-radius: var(--radius-lg); border: 1px solid var(--border);">
				<h3 style="font-size: 18px; font-weight: 600; margin-bottom: var(--space-xs); color: var(--ink);">Test Before You Buy</h3>
				<p style="color: var(--body); font-size: 14px; margin-bottom: var(--space-md);">Try out this skill to ensure it meets your needs. Testing consumes <strong>{({1:10, 2:20, 3:40, 4:70, 5:100} as Record<number, number>)[skill.complexity_level || 1] || ((skill.complexity_level || 1) * 10)} Bodhic Credits</strong> per interaction based on its Level {skill.complexity_level || 1} complexity rating.</p>
				
				<div style="display: flex; flex-direction: column; gap: var(--space-sm);">
					<a href={`/chat/${skill.id}`} target="_blank" class="btn btn-primary" style="width: 100%; display: flex; justify-content: center; align-items: center; gap: 8px; padding: 14px; text-decoration: none;">
						<span style="font-size: 18px;">✨</span> Test with Bodhic LLM Web Chat
					</a>
					<McpTestIsland client:load skillId={skill.id} />
				</div>
			</div>
		</div>
	)}
</Layout>
