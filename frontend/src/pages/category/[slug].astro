---
import Layout from '../../layouts/Layout.astro';
import BrowseByCategoryIsland from '../../components/BrowseByCategoryIsland.tsx';

const { slug } = Astro.params;
const originalName = slug || '';
const displayCategory = originalName.split('-').map((w: string) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
---

<Layout 
	title={`Buy ${displayCategory} AI Agent Skills & Prompts — BodhicAI`}
	description={`Browse the best verified ${displayCategory} AI agent skills and prompts on BodhicAI. No buyer markup, instant downloads, and 100% security scanned.`}
>
	<div style="max-width: 1200px; margin: 0 auto; padding-top: var(--space-2xl);">
		<BrowseByCategoryIsland client:load slug={slug} displayCategory={displayCategory} />
	</div>
</Layout>
