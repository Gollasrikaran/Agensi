---
import Layout from '../layouts/Layout.astro';
import McpConfigTabsIsland from '../components/McpConfigTabsIsland';
import McpVideoPlayerIsland from '../components/McpVideoPlayerIsland';
---

<Layout 
	title="MCP — Connect Your AI Agent | BodhicAI"
	description="Use the Model Context Protocol (MCP) to connect AI agents like Cursor, Windsurf, and Claude Desktop to the BodhicAI skill marketplace. Try skills before you buy."
>
	<div class="max-w-[1140px] mx-auto px-6 py-16">
		
		<!-- Hero -->
		<div class="text-center mb-16">
			<span class="inline-flex items-center gap-2 rounded-full bg-indigo-500/10 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-indigo-400 border border-indigo-500/20 mb-6 font-mono">MODEL CONTEXT PROTOCOL</span>
			<h1 class="text-[clamp(32px,5vw,48px)] mb-6 leading-[1.2] font-bold text-zinc-100">
				Connect Your AI Agent to<br/>
				<span class="bg-gradient-to-r from-indigo-400 to-purple-400 bg-clip-text text-transparent">Every Skill on Bodhic</span>
			</h1>
			<p class="text-zinc-300 text-lg max-w-[650px] mx-auto leading-[1.6]">
				Use MCP to let your AI coding assistant search, try, and use skills directly from the marketplace — without leaving your editor.
			</p>
		</div>

		<!-- Video Demo Section (Full Screen / High Res with 10s Skip & No Double Mac Window) -->
		<div class="mb-16">
			<div class="text-center mb-12">
				<div class="inline-flex items-center gap-2 bg-purple-500/20 text-purple-400 px-4 py-1.5 rounded-full text-[13px] font-bold tracking-[0.5px] mb-3">
					WATCH IT IN ACTION
				</div>
				<h2 class="text-[clamp(24px,3.5vw,32px)] font-bold m-0 text-zinc-100">See How Easy It Is to Use Bodhic MCP</h2>
				<p class="text-zinc-300 text-base mt-2 mx-auto max-w-[700px]">Watch this 4-minute full-screen walkthrough showing real agent workflows in Cursor, Windsurf, and Claude.</p>
			</div>
			<McpVideoPlayerIsland client:load />
		</div>

		<!-- How It Works -->
		<div class="grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-8 mb-16">
			<div class="flex flex-col p-8 rounded-2xl border border-zinc-800 bg-zinc-900/50 text-center hover:-translate-y-1 hover:bg-zinc-800 transition-all">
				<div class="text-sm font-bold text-indigo-400 tracking-[1px] uppercase mb-2">Step 1</div>
				<h3 class="text-lg mb-2 text-zinc-100 font-bold">Get an API Key</h3>
				<p class="text-zinc-400 text-sm leading-[1.6]">Go to <a href="/dashboard/developer" class="text-indigo-400 font-medium hover:text-indigo-300 transition-colors">Developer Dashboard</a> and generate a free API key.</p>
			</div>
			<div class="flex flex-col p-8 rounded-2xl border border-zinc-800 bg-zinc-900/50 text-center hover:-translate-y-1 hover:bg-zinc-800 transition-all">
				<div class="text-sm font-bold text-indigo-400 tracking-[1px] uppercase mb-2">Step 2</div>
				<h3 class="text-lg mb-2 text-zinc-100 font-bold">Connect Your Agent</h3>
				<p class="text-zinc-400 text-sm leading-[1.6]">Add the MCP config snippet to Cursor, Windsurf, or Claude Desktop.</p>
			</div>
			<div class="flex flex-col p-8 rounded-2xl border border-zinc-800 bg-zinc-900/50 text-center hover:-translate-y-1 hover:bg-zinc-800 transition-all">
				<div class="text-sm font-bold text-indigo-400 tracking-[1px] uppercase mb-2">Step 3</div>
				<h3 class="text-lg mb-2 text-zinc-100 font-bold">Try Before You Buy</h3>
				<p class="text-zinc-400 text-sm leading-[1.6]">Chat with any skill for <strong class="text-zinc-200">dynamic credits (10 to 100)</strong> per interaction based on complexity. Love it? Buy it for unlimited use.</p>
			</div>
		</div>

		<!-- Setup Guide -->
		<div class="p-8 md:p-12 rounded-2xl border border-zinc-800 bg-zinc-900/50 mb-12">
			<h2 class="text-2xl mb-8 text-zinc-100 font-bold">Quick Setup Guide</h2>
			
			<h3 class="text-lg mb-4 text-zinc-100 font-bold">Step 1 — Generate Your API Key</h3>
			<p class="text-zinc-300 leading-[1.6] mb-6">
				Head to the <a href="/dashboard/developer" class="text-indigo-400 font-semibold hover:text-indigo-300 transition-colors">Developer Dashboard</a> and click <strong class="text-zinc-100">"Generate New Key"</strong>. Copy the key immediately — for security, it is only shown once.
			</p>

			<h3 class="text-lg mb-4 text-zinc-100 font-bold">Step 2 — Add MCP Config to Your Editor or Web Agent</h3>
			<p class="text-zinc-300 leading-[1.6] mb-4">
				Select your AI environment below to get the exact JSON snippet or direct URL:
			</p>
			
			<McpConfigTabsIsland client:load apiKey="YOUR_API_KEY" />
		</div>

		<!-- Credits System -->
		<div class="p-8 md:p-12 rounded-2xl border border-zinc-800 bg-zinc-900/50 mb-12">
			<h2 class="text-2xl mb-8 text-zinc-100 font-bold">Credits System</h2>
			
			<p class="text-zinc-300 leading-[1.8] mb-8">
				Credits let you <strong class="text-zinc-100">try before you buy</strong>. Every MCP interaction with a skill consumes <strong class="text-zinc-100">dynamic Bodhic Credits (10 to 100 CR)</strong> depending on its AI Complexity Level (Level 1: 10 CR, Level 2: 20 CR, Level 3: 40 CR, Level 4: 70 CR, Level 5: 100 CR). Once you purchase a skill outright, all future interactions with it are <strong class="text-zinc-100">completely free</strong>.
			</p>

			<div class="grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-6 mb-8">
				<div class="p-6 rounded-xl bg-indigo-500/5 border border-indigo-500/20 text-center">
					<div class="text-[clamp(20px,4vw,28px)] font-bold text-indigo-400">1,000</div>
					<div class="text-[13px] text-zinc-400 mt-1">Credits for ₹100</div>
				</div>
				<div class="p-6 rounded-xl bg-purple-500/5 border border-purple-500/20 text-center">
					<div class="text-[clamp(20px,4vw,28px)] font-bold text-purple-400">5,500</div>
					<div class="text-[13px] text-zinc-400 mt-1">Credits for ₹499 <span class="text-emerald-500 font-semibold">+500 Bonus</span></div>
				</div>
			</div>

			<a href="/dashboard/buyer" class="inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-6 py-2.5 text-sm font-bold text-white shadow-lg transition-all hover:bg-indigo-500 hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2 focus-visible:ring-offset-zinc-950 disabled:opacity-50 no-underline">
				Top Up Credits →
			</a>
		</div>

		<!-- Available MCP Tools -->
		<div class="p-8 md:p-12 rounded-2xl border border-zinc-800 bg-zinc-900/50 mb-12">
			<h2 class="text-2xl mb-8 text-zinc-100 font-bold">Available MCP Tools</h2>
			<p class="text-zinc-300 leading-[1.6] mb-8">
				Once connected, your AI agent can call these tools automatically:
			</p>
			
			<div class="flex flex-col gap-4">
				<div class="flex gap-4 items-start p-4 rounded-xl bg-black/20 border border-zinc-800 flex-wrap">
					<code class="bg-indigo-500/15 text-indigo-400 px-2.5 py-1 rounded-md text-[13px] whitespace-nowrap font-semibold">search_skills</code>
					<span class="text-zinc-300 text-sm leading-[1.5]">Search the entire Bodhic marketplace by keyword. Returns matching skills with descriptions, prices, and ratings.</span>
				</div>
				<div class="flex gap-4 items-start p-4 rounded-xl bg-black/20 border border-zinc-800 flex-wrap">
					<code class="bg-purple-500/15 text-purple-400 px-2.5 py-1 rounded-md text-[13px] whitespace-nowrap font-semibold">chat_with_skill</code>
					<span class="text-zinc-300 text-sm leading-[1.5]">Try a skill by chatting with it. Uses dynamic credits (10-100 CR based on complexity) per interaction. Free if you've already purchased the skill.</span>
				</div>
				<div class="flex gap-4 items-start p-4 rounded-xl bg-black/20 border border-zinc-800 flex-wrap">
					<code class="bg-emerald-500/15 text-emerald-500 px-2.5 py-1 rounded-md text-[13px] whitespace-nowrap font-semibold">get_credit_balance</code>
					<span class="text-zinc-300 text-sm leading-[1.5]">Check your remaining Bodhic Credit balance directly from your editor.</span>
				</div>
			</div>
		</div>

		<!-- API Key Security -->
		<div class="p-8 md:p-12 rounded-2xl border border-zinc-800 bg-zinc-900/50 mb-12">
			<h2 class="text-2xl mb-8 text-zinc-100 font-bold">API Key Security & Privacy</h2>
			<ul class="text-zinc-300 leading-loose ml-8 text-[15px] list-disc">
				<li>API keys are <strong class="text-zinc-100">shown only once</strong> at creation. Copy it immediately.</li>
				<li>We store only a <strong class="text-zinc-100">SHA-256 hash</strong> of your key — we can never see it.</li>
				<li>You can <strong class="text-zinc-100">revoke</strong> any key at any time from the Developer Dashboard.</li>
				<li>Keys are prefixed with <code class="bg-black/20 px-1.5 py-0.5 rounded text-sm text-zinc-400">bodhic_</code> for easy identification.</li>
				<li>If you lose a key, simply revoke it and generate a new one.</li>
			</ul>
		</div>

		<!-- CTA -->
		<div class="text-center py-12">
			<h2 class="text-[clamp(20px,4vw,28px)] mb-4 text-zinc-100 font-bold">Ready to supercharge your AI agent?</h2>
			<p class="text-zinc-300 text-base mb-8">Generate your API key and start using skills in under 2 minutes.</p>
			<a href="/dashboard/developer" class="inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-8 py-3.5 text-base font-bold text-white shadow-lg shadow-indigo-500/20 transition-all hover:bg-indigo-500 hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2 focus-visible:ring-offset-zinc-950 disabled:opacity-50 no-underline">
				Go to Developer Dashboard →
			</a>
		</div>
	</div>
</Layout>
