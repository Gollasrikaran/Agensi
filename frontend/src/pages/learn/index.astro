---
import Layout from '../../layouts/Layout.astro';

const posts = [
  {
    title: "How to prevent Prompt Injections in your Agents",
    slug: "preventing-prompt-injections",
    description: "Learn the fundamentals of securing your AI agent skills against malicious user inputs and jailbreaks before uploading to BodhicAI.",
    date: "July 12, 2026"
  },
  {
    title: "Maximizing Your Earnings with Monthly Subscriptions",
    slug: "maximizing-earnings-subscriptions",
    description: "Why switching your skills from a one-time purchase to a monthly subscription can 10x your creator revenue.",
    date: "July 10, 2026"
  },
  {
    title: "Winning the Monthly Creator Contest",
    slug: "winning-creator-contest",
    description: "Strategies to optimize your skill listing, gain upvotes, and take home the ₹20,000 monthly BodhicAI prize.",
    date: "July 8, 2026"
  }
];
---

<Layout 
	title="Learning Center — BodhicAI"
	description="Read tutorials and guides on prompt engineering, AI agent security, and maximizing your earnings on BodhicAI."
>
	<div class="max-w-[1000px] mx-auto pt-16">
		<div class="mb-12">
			<span class="inline-flex items-center gap-2 rounded-full bg-indigo-500/10 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-indigo-400 border border-indigo-500/20 mb-6 font-mono">learning center</span>
			<h1 class="text-[clamp(28px,6vw,48px)] mb-2 tracking-[-1px] text-zinc-100 font-bold">
				Master <span class="bg-gradient-to-r from-indigo-400 to-emerald-400 bg-clip-text text-transparent">Prompt Engineering</span>
			</h1>
			<p class="text-zinc-300 text-lg max-w-[600px]">
				Tutorials, security guides, and strategies to build better AI agent skills.
			</p>
		</div>

		<div class="flex flex-col gap-8">
			{posts.map(post => (
				<a href={`/learn/${post.slug}`} class="group flex flex-col p-6 md:p-8 rounded-2xl border border-zinc-800 bg-zinc-900/50 hover:bg-zinc-800 transition-all hover:-translate-y-1 hover:shadow-xl hover:border-indigo-500/50 relative overflow-hidden no-underline mb-8 block">
					<div class="text-zinc-400 font-mono text-sm mb-2">{post.date}</div>
					<h2 class="text-2xl text-zinc-100 mb-4 font-bold">{post.title}</h2>
					<p class="text-zinc-300 text-base leading-[1.6] m-0">{post.description}</p>
				</a>
			))}
		</div>
	</div>
</Layout>
