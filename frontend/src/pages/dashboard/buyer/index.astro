---
import Layout from '../../../layouts/Layout.astro';
import BuyerDashboardIsland from '../../../components/BuyerDashboardIsland.tsx';
import CreditWalletIsland from '../../../components/CreditWalletIsland.tsx';
---
<Layout 
	title="Buyer Dashboard — BodhicAI"
	description="Access your purchased AI agent skills, prompts, and workflows in your private buyer dashboard."
>
	<div class="mx-auto max-w-5xl pt-16 px-4 sm:px-6 lg:px-8 pb-32">
		<div class="mb-10">
			<div class="flex gap-6 mb-8 border-b border-zinc-800">
				<a href="/dashboard/buyer" class="px-2 py-3 font-semibold text-indigo-400 border-b-2 border-indigo-400 transition-colors">Buyer Dashboard</a>
				<a href="/dashboard/seller" class="px-2 py-3 font-medium text-zinc-500 hover:text-zinc-300 transition-colors">Creator Dashboard</a>
			</div>
			<span class="inline-block px-4 py-1.5 mb-4 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 font-mono text-xs font-semibold tracking-widest uppercase">
				Buyer
			</span>
			<h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-100 mb-2">Dashboard</h1>
			<p class="text-zinc-400 text-lg">View your purchased skills and access artifacts.</p>
		</div>
		<div class="mb-12">
			<CreditWalletIsland client:load />
		</div>
		<BuyerDashboardIsland client:load />
	</div>
</Layout>
