---
import Layout from './Layout.astro';
const { title, description, lastUpdated } = Astro.props;
---

<Layout title={`${title} | BodhicAI`} description={description}>
  <div class="max-w-4xl mx-auto my-16 px-6 lg:px-8">
    <article class="rounded-3xl border border-zinc-800 bg-zinc-900/50 p-8 md:p-12 shadow-xl relative overflow-hidden">
      <!-- Glow effect -->
      <div class="absolute -top-40 -left-40 w-80 h-80 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>
      
      <header class="mb-12 border-b border-zinc-800 pb-8 relative z-10 text-center">
        <h1 class="text-3xl md:text-5xl font-black mb-6 bg-gradient-to-br from-white to-zinc-400 bg-clip-text text-transparent leading-tight">{title}</h1>
        {description && <p class="text-xl text-zinc-400 leading-relaxed mb-4">{description}</p>}
        {lastUpdated && <p class="text-sm text-zinc-500 font-mono font-medium">Last Updated: {lastUpdated}</p>}
      </header>
      <div class="legal-content relative z-10 text-zinc-300">
        <slot />
      </div>
    </article>
  </div>
</Layout>

<style>
  .legal-content :global(h2) {
    @apply text-2xl md:text-3xl font-bold text-zinc-100 mt-12 mb-6 tracking-tight;
  }
  
  .legal-content :global(h3) {
    @apply text-xl md:text-2xl font-bold text-zinc-200 mt-10 mb-4;
  }

  .legal-content :global(p) {
    @apply mb-6 leading-relaxed text-[15px] md:text-base;
  }

  .legal-content :global(ul), .legal-content :global(ol) {
    @apply mb-6 pl-6 leading-relaxed space-y-2;
  }
  
  .legal-content :global(ul) {
    @apply list-disc marker:text-zinc-600;
  }
  
  .legal-content :global(ol) {
    @apply list-decimal marker:text-zinc-500 font-medium;
  }

  .legal-content :global(a) {
    @apply text-indigo-400 hover:text-indigo-300 underline decoration-indigo-500/30 hover:decoration-indigo-400 transition-colors;
  }

  .legal-content :global(strong) {
    @apply font-bold text-zinc-100;
  }
</style>
